# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.swp

# Node (per-package node_modules/dist are also gitignored individually;
# these are a repo-wide safety net for any other nested package)
node_modules/
dist/
dist-ssr/
*.log
npm-debug.log*
coverage/

# Env files (never commit real secrets; .env.example files are kept)
.env
.env.local
.env.*.local
!.env.example

# Terraform (infra/.gitignore also covers this; kept here too since
# some tooling runs `terraform` from the repo root)
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
*.tfvars
!*.tfvars.example
